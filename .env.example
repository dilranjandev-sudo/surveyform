# Supabase — copy this file to .env.local and fill in real values.
# Find these in your Supabase project: Settings → API.

# Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service-role key — SERVER SECRET. Never commit this, never expose to the browser.
# Used only inside app/api/submit/route.ts (server-side).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
