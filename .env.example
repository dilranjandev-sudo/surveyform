# Copy this file to .env.local and fill in the real value.

# Supabase Postgres connection string — the ONLY required env var.
# Supabase Dashboard -> Connect -> "Session pooler" (recommended for hosting)
# or the direct connection string. Format:
#   postgresql://postgres:PASSWORD@db.PROJECT-REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# The admin login (for /admin) is stored in the database, not in env.
# Set or change it with:
#   node --env-file=.env.local scripts/set-admin-password.mjs admin "YourPassword"
