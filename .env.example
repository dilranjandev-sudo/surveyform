# Copy this file to .env.local and fill in the real values.

# Supabase Postgres connection string.
# Supabase Dashboard -> Connect -> "Session pooler" (recommended for hosting)
# or the direct connection string. Format:
#   postgresql://postgres:PASSWORD@db.PROJECT-REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Admin dashboard login — protects the /admin page (HTTP Basic Auth).
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-password
